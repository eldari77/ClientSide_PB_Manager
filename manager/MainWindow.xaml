<Window x:Class="NOVALI.ClientSidePBManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOVALI Client-Side PB Bridge" Height="760" Width="1180"
        MinHeight="620" MinWidth="980">
    <DockPanel Background="#F5F7FA">
        <Border DockPanel.Dock="Top" Background="#1E293B" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="NOVALI Client-Side PB Bridge" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="RootText" Foreground="#CBD5E1" FontSize="12" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="#BAE6FD" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TabControl Margin="12" Background="#F5F7FA">
            <TabItem Header="Workshop Scripts">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Refresh" Width="92" Margin="0,0,8,0" Click="RefreshWorkshop_Click" />
                        <Button Content="Open Page" Width="92" Margin="0,0,8,0" Click="OpenWorkshop_Click" />
                        <Button Content="Import" Width="92" Margin="0,0,8,0" Click="ImportWorkshop_Click" />
                        <Button Content="Prepare Adapter" Width="124" Margin="0,0,16,0" Click="PrepareAdapter_Click" />
                        <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="WorkshopFilterBox" Width="260" Margin="0,0,12,0" TextChanged="WorkshopFilterBox_TextChanged" />
                        <TextBlock Text="Kind" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="KindFilterBox" Width="130" SelectionChanged="KindFilterBox_SelectionChanged">
                            <ComboBoxItem Content="all" IsSelected="True" />
                            <ComboBoxItem Content="pb_script" />
                            <ComboBoxItem Content="mod_script" />
                            <ComboBoxItem Content="blueprint" />
                            <ComboBoxItem Content="unknown" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#475569"
                               Text="manual_adapter_required means the Workshop PB script was found locally, but needs an adapter scaffold before it can run in the Docker worker." />
                    <DataGrid x:Name="WorkshopGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Workshop Id" Binding="{Binding WorkshopId}" Width="110" />
                            <DataGridTextColumn Header="Name" Binding="{Binding HumanName}" Width="260" />
                            <DataGridTextColumn Header="Local Title" Binding="{Binding DetectedTitle}" Width="180" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding DetectedKind}" Width="110" />
                            <DataGridTextColumn Header="Compatibility" Binding="{Binding Compatibility}" Width="160" />
                            <DataGridTextColumn Header="Updated" Binding="{Binding TimeUpdated}" Width="170" />
                            <DataGridTextColumn Header="Hash" Binding="{Binding ShortHash}" Width="110" />
                            <DataGridTextColumn Header="Path" Binding="{Binding SourcePath}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Bridges">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Refresh" Width="92" Margin="0,0,8,0" Click="RefreshFiles_Click" />
                        <Button Content="Open Data" Width="92" Click="OpenData_Click" />
                    </StackPanel>
                    <Border x:Name="BridgePbConfigPrompt" DockPanel.Dock="Bottom" Visibility="Collapsed"
                            BorderBrush="#38BDF8" BorderThickness="1" Background="#E0F2FE"
                            Padding="10" Margin="0,8,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="BridgePbConfigPromptTitle" FontWeight="SemiBold"
                                           Foreground="#0F172A" VerticalAlignment="Center" />
                                <Button Content="Copy" Width="72" Margin="12,0,8,0" Click="CopyBridgePbConfig_Click" />
                                <Button Content="Dismiss" Width="72" Click="DismissBridgePbConfig_Click" />
                            </StackPanel>
                            <TextBox x:Name="BridgePbConfigBox" Height="145" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </Border>
                    <DataGrid x:Name="BridgeGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" SelectionChanged="BridgeGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="220" />
                            <DataGridTextColumn Header="Updated" Binding="{Binding Updated}" Width="180" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100" />
                            <DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Worker Scripts">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Refresh" Width="92" Margin="0,0,8,0" Click="RefreshWorkerScripts_Click" />
                        <Button Content="Save Manifest" Width="112" Margin="0,0,16,0" Click="SaveWorkerManifest_Click" />
                        <TextBlock Text="Bridge" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="WorkerBridgeIdBox" Width="150" Text="pb-bridge-001" Margin="0,0,8,0" TextChanged="WorkerBridgeIdBox_TextChanged" />
                        <TextBlock Text="Selected Script" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="BridgeSelectedScriptBox" Width="230" Margin="0,0,8,0"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="ScriptId"
                                  SelectionChanged="BridgeSelectedScriptBox_SelectionChanged" />
                        <Button Content="Save Bridge" Width="98" Margin="0,0,8,0" Click="SaveBridgeScripts_Click" />
                        <Button Content="PB Config" Width="92" Click="ShowPbConfig_Click" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#475569"
                               Text="Enable controls whether Docker may run a worker adapter. Allowed For Bridge controls which enabled adapters this bridge may request." />
                    <TextBlock x:Name="LatestWorkerSummaryText" DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#334155"
                               Text="Latest worker summary: no bridge result loaded." />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="WorkerGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="False"
                                  CanUserAddRows="False" SelectionMode="Single" SelectionChanged="WorkerGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Script Id" Binding="{Binding ScriptId}" Width="180" IsReadOnly="True" />
                                <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="220" IsReadOnly="True" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="140" IsReadOnly="True" />
                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                <DataGridCheckBoxColumn Header="Allowed For Bridge" Binding="{Binding AllowedForBridge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                                <DataGridTextColumn Header="Timeout Ms" Binding="{Binding TimeoutMs}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="*" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                        <TabControl Grid.Row="2">
                            <TabItem Header="Local Copy">
                                <DockPanel Margin="0,8,0,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Load Local Copy" Width="116" Margin="0,0,8,0" Click="LoadWorkerLocalCopy_Click" />
                                        <Button Content="Save Local Copy" Width="116" Margin="0,0,16,0" Click="SaveWorkerLocalCopy_Click" />
                                        <TextBlock Text="Clone Id" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox x:Name="CloneScriptIdBox" Width="190" Margin="0,0,8,0" />
                                        <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox x:Name="CloneDisplayNameBox" Width="220" Margin="0,0,8,0" />
                                        <Button Content="Clone" Width="82" Click="CloneWorkerScript_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="WorkerScriptPathText" DockPanel.Dock="Top" Margin="0,0,0,6"
                                               Foreground="#475569" Text="Select a worker script to edit its local copy." />
                                    <TextBox x:Name="WorkerScriptEditor" AcceptsReturn="True" AcceptsTab="True"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             TextWrapping="NoWrap" FontFamily="Consolas" />
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Config">
                                <DockPanel Margin="0,8,0,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Load Config" Width="104" Margin="0,0,8,0" Click="LoadWorkerConfig_Click" />
                                        <Button Content="Save Config" Width="104" Margin="0,0,8,0" Click="SaveWorkerConfig_Click" />
                                        <Button Content="Extract Config" Width="112" Click="ExtractWorkerConfig_Click" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Top" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.ColumnSpan="6" Text="Inventory Sorting" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <CheckBox x:Name="InventorySortingEnabledBox" Grid.Row="1" Grid.Column="0" Content="Apply enabled" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <CheckBox x:Name="InventorySortingDryRunBox" Grid.Row="1" Grid.Column="1" Content="Dry run" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <CheckBox x:Name="AllowConnectedGridsBox" Grid.Row="1" Grid.Column="2" Content="Connected grids" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="0,0,12,0">
                                                <TextBlock Text="Apply/tick" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox x:Name="MaxApplyCommandsBox" Width="48" Text="1" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Margin="0,0,12,0">
                                                <TextBlock Text="Plan/tick" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox x:Name="MaxPlannedTransfersBox" Width="48" Text="8" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Grid.Column="5" Foreground="#475569" Text="These write to the selected worker config." VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <DataGrid x:Name="WorkerConfigGrid" AutoGenerateColumns="False" CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="210" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Value" Binding="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="240" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding ValueType}" Width="90" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Limits">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Load" Width="92" Margin="0,0,8,0" Click="LoadLimits_Click" />
                        <Button Content="Save" Width="92" Margin="0,0,16,0" Click="SaveLimits_Click" />
                        <TextBlock Text="Persisted in data\bridge_limits.json" VerticalAlignment="Center" Foreground="#475569" />
                    </StackPanel>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Runtime ms limit" Margin="0,0,8,8" VerticalAlignment="Center" />
                        <TextBox x:Name="RuntimeMsLimitBox" Grid.Row="0" Grid.Column="1" Text="0.03" Margin="0,0,12,8" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Hard ceiling; PB enters cooldown at or above this value." Foreground="#475569" VerticalAlignment="Center" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Runtime ms soft ratio" Margin="0,0,8,8" VerticalAlignment="Center" />
                        <TextBox x:Name="RuntimeMsSoftRatioBox" Grid.Row="1" Grid.Column="1" Text="0.75" Margin="0,0,12,8" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Soft skip threshold as a fraction of the hard ceiling." Foreground="#475569" VerticalAlignment="Center" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Cooldown seconds" Margin="0,0,8,8" VerticalAlignment="Center" />
                        <TextBox x:Name="CooldownSecondsBox" Grid.Row="2" Grid.Column="1" Text="10" Margin="0,0,12,8" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="How long the PB waits after crossing the hard ceiling." Foreground="#475569" VerticalAlignment="Center" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Max commands per minute" Margin="0,0,8,8" VerticalAlignment="Center" />
                        <TextBox x:Name="LimitMaxCommandsBox" Grid.Row="3" Grid.Column="1" Text="30" Margin="0,0,12,8" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Existing rate throttle; runtime limiter still runs first." Foreground="#475569" VerticalAlignment="Center" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Fail closed" Margin="0,0,8,8" VerticalAlignment="Center" />
                        <CheckBox x:Name="LimitFailClosedCheckBox" Grid.Row="4" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,8" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Invalid limiter config blocks outbound PB work." Foreground="#475569" VerticalAlignment="Center" Margin="0,0,0,8" />
                    </Grid>

                    <TextBox x:Name="LimitsOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Docker">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Start" Width="92" Margin="0,0,8,0" Click="DockerStart_Click" />
                        <Button Content="Stop" Width="92" Margin="0,0,8,0" Click="DockerStop_Click" />
                        <Button Content="Status" Width="92" Click="DockerStatus_Click" />
                    </StackPanel>
                    <TextBox x:Name="DockerOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Logs">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Refresh" Width="92" Click="RefreshLogs_Click" />
                    </StackPanel>
                    <TextBox x:Name="LogOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
